# URL of the FastAPI/LangGraph service. Do not expose model credentials here.
LANGGRAPH_AGENT_URL=http://localhost:8123

# Optional CARTO token for future CARTO Maps/data-layer integration.
# NEXT_PUBLIC_ variables are sent to the browser: use a read-only token limited
# to this application's allowed origins. The current public CARTO basemap does
# not require this token.
NEXT_PUBLIC_CARTO_API_KEY=

# Optional: enables CopilotKit Intelligence features such as durable threads.
# CPK_INTELLIGENCE_API_KEY=cpk_...
